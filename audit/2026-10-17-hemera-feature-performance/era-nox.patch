+            if ($lookup | get $'plan/($r.file)') != $r.sha256 or ($sizes | get $'plan/($r.file)') != $r.bytes { error make {msg: 'support identity'} }
+        }
+        let sections = (json $lookup $dest plan/sections.json)
+        let parts = ($sections | enumerate | each {|v|
